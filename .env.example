# ---------- Cloudflare Tunnel (optional) ----------
# Token for a remotely-managed ("named") Cloudflare Tunnel — the tunnel
# starts automatically when this is set; leave blank to disable.
# Create one at https://one.dash.cloudflare.com -> Networks -> Tunnels,
# then point the tunnel's public hostname at http://neighbourhood-similarity:8000
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- App (defaults shown — optional to set) ----------
# Port the UI is published on locally
APP_PORT=8000

# Host directory bind-mounted into the container at /data (persistent cache)
DATA_DIR=./data

# Free OSM services. Point at mirrors/self-hosted instances for heavy use.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter
# Identifies you to Nominatim/Overpass. Add your contact info in parentheses —
# but NOT a placeholder like you@example.com: Nominatim blocks those with 403.
USER_AGENT=neighbourhood-similarity/1.0

# Radius (m) used to characterise one neighbourhood
PROFILE_RADIUS_M=1500
# Max candidate neighbourhoods profiled per search
MAX_CANDIDATES=24
# Concurrent Overpass queries
OVERPASS_CONCURRENCY=4
# Matches returned per search
TOP_MATCHES=12

# Rate-limiting / politeness (protects you from public API blocks)
# Min seconds between requests to the same host (Nominatim policy is 1/s)
MIN_REQUEST_INTERVAL_S=1.5
# Extra wait before a failed query retries on the next Overpass mirror
FAILOVER_DELAY_S=3
# Base wait before a failed candidate is retried (+0-4s jitter)
RETRY_DELAY_S=10
# Circuit breaker: skip a failed mirror for N seconds x consecutive failures
FAIL_COOLDOWN_S=60
# When every mirror fails, pause this long then retry them all (UI countdown)
ALL_MIRRORS_WAIT_S=60
# Hard cap on the candidate-profiling stage — returns partial results
PROFILE_BUDGET_S=240
# Hard cap on the geocode+discovery stage before erroring out
MANDATORY_BUDGET_S=150
